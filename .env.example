# Connection string for the Game Lounge's OWN isolated Neon Postgres
# instance. Must NEVER point at the main mentorship platform's database.
LOUNGE_DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/menty_game_lounge?sslmode=require"

# Must be identical to the main mentorship platform's NEXTAUTH_SECRET.
# This shared secret is the only coupling between the two apps — it lets
# this app verify (but not create) session tokens issued by the main app.
NEXTAUTH_SECRET="replace-with-the-main-app-shared-secret"
